// Catatan Keuangan Pribadi — skema data.
//
// Prinsip:
// - Semua nominal disimpan sebagai integer Rupiah (Int). Target Goal memakai BigInt
//   karena bisa melebihi 2,1 milyar (batas Int 32-bit di PostgreSQL).
// - Tidak ada kolom total. Semua total/sisa/persentase dihitung dari baris transaksi.
// - Nilai "enum" disimpan sebagai String (portabel SQLite <-> PostgreSQL) dan
//   divalidasi di aplikasi lewat Zod (lihat src/lib/constants.ts).
// - Bulan disimpan sebagai "YYYY-MM".
//
// Pindah ke PostgreSQL: ganti `provider = "sqlite"` menjadi "postgresql"
// (lihat README), lalu jalankan migrasi.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Pengaturan (satu baris, id = 1)
// ---------------------------------------------------------------------------
model AppSetting {
  id                 Int       @id @default(1)
  birthDate          DateTime?
  /// Bunga deposito dalam basis poin (750 = 7,5%)
  depositRateBps     Int       @default(750)
  /// Pajak bunga dalam basis poin (2000 = 20%)
  interestTaxBps     Int       @default(2000)
  /// Ambang peringatan aset turun, basis poin (3000 = 30%)
  assetDropAlertBps  Int       @default(3000)
  updatedAt          DateTime  @updatedAt
}

/// Pembatas percobaan login (anti brute force). key = "ip:<alamat>" atau "global".
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?
  lockCount   Int       @default(0)
}

// ---------------------------------------------------------------------------
// Kategori & bulan & transaksi
// ---------------------------------------------------------------------------
model Category {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  /// "EXPENSE" | "INCOME" — hanya "Pemasukan" yang INCOME
  kind           String  @default("EXPENSE")
  /// Target % dari gaji dalam basis poin (4000 = 40%). 0 = tanpa target.
  targetBps      Int     @default(0)
  color          String  @default("#64748b")
  sortOrder      Int     @default(0)

  transactions   Transaction[]
  templates      RecurringTemplate[]
}

model MonthlyPeriod {
  id            Int      @id @default(autoincrement())
  /// "YYYY-MM" — unik: satu bulan = satu sumber data
  month         String   @unique
  /// Gaji bulan ini (Rupiah). null = belum diisi.
  salary        Int?
  /// true = bulan Rencana; false = Tercatat. Status "Tidak lengkap" diturunkan otomatis.
  isPlan        Boolean  @default(false)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  Transaction[]
}

model Transaction {
  id          Int      @id @default(autoincrement())
  periodId    Int
  period      MonthlyPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  name        String
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  /// Rupiah, selalu positif. Arah ditentukan kategori (Pemasukan = masuk).
  /// null = nominal belum diisi -> bulan ditandai "Tidak lengkap".
  amount      Int?
  /// Checklist "sudah dibayar". Tetap dihitung di Sisa walau belum dibayar.
  isPaid      Boolean  @default(false)
  note        String?
  /// "MANUAL" | "TEMPLATE" | "IMPORT" | "DEBT_PLAN" | "RECEIVABLE"
  source      String   @default("MANUAL")
  /// Kunci unik untuk import idempotent (null untuk input manual)
  importKey   String?  @unique

  debtPlanId               Int?  @unique
  debtPlan                 DebtPlan? @relation(fields: [debtPlanId], references: [id], onDelete: SetNull)
  receivableInstallmentId  Int?  @unique
  receivableInstallment    ReceivableInstallment? @relation(fields: [receivableInstallmentId], references: [id], onDelete: SetNull)
  receivableEntryId        Int?  @unique
  receivableEntry          ReceivableEntry? @relation(fields: [receivableEntryId], references: [id], onDelete: SetNull)
  goalId                   Int?
  goal                     Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  investmentId             Int?
  investment               Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)

  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([periodId])
  @@index([categoryId])
  @@index([goalId])
}

model RecurringTemplate {
  id             Int      @id @default(autoincrement())
  name           String
  categoryId     Int
  category       Category @relation(fields: [categoryId], references: [id])
  defaultAmount  Int?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
}

// ---------------------------------------------------------------------------
// Hutang (saya berutang)
// ---------------------------------------------------------------------------
model Debt {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  /// "KARTU" | "PAYLATER" | "PRIBADI" | "LAINNYA"
  kind       String
  active     Boolean  @default(true)
  note       String?
  sortOrder  Int      @default(0)

  snapshots  DebtSnapshot[]
  plans      DebtPlan[]
  entries    DebtEntry[]
}

/// Saldo sisa hutang per bulan
model DebtSnapshot {
  id       Int    @id @default(autoincrement())
  debtId   Int
  debt     Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)
  month    String
  balance  Int

  @@unique([debtId, month])
}

/// Rencana bayar per bulan. Saat dibayar -> membuat Transaction kategori Cicilan.
model DebtPlan {
  id           Int     @id @default(autoincrement())
  debtId       Int
  debt         Debt    @relation(fields: [debtId], references: [id], onDelete: Cascade)
  month        String
  amount       Int
  paid         Boolean @default(false)
  transaction  Transaction?

  @@unique([debtId, month])
}

/// Hutang ke orang: catatan per tanggal. amount positif = pinjam, negatif = bayar.
model DebtEntry {
  id           Int      @id @default(autoincrement())
  debtId       Int
  debt         Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  date         DateTime
  description  String
  amount       Int
}

// ---------------------------------------------------------------------------
// Piutang (orang lain berutang ke saya)
// ---------------------------------------------------------------------------
model Receivable {
  id                 Int      @id @default(autoincrement())
  name               String
  /// "CICILAN" = jadwal cicilan tetap; "BEBAS" = sekali bayar / nyicil bebas (catatan debit-kredit)
  kind               String   @default("CICILAN")
  /// CICILAN: modal yang dipinjamkan. BEBAS: tidak dipakai (dihitung dari catatan).
  principal          Int      @default(0)
  installmentCount   Int      @default(0)
  installmentAmount  Int      @default(0)
  /// Tanggal jatuh tempo dalam bulan (1..31)
  dueDay             Int?
  /// Bulan cicilan pertama "YYYY-MM" (CICILAN)
  startMonth         String?
  note               String?
  createdAt          DateTime @default(now())

  installments       ReceivableInstallment[]
  entries            ReceivableEntry[]
}

/// Catatan piutang jenis BEBAS: amount positif = dipinjamkan (debit), negatif = dibayar (kredit).
model ReceivableEntry {
  id            Int        @id @default(autoincrement())
  receivableId  Int
  receivable    Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  date          DateTime
  description   String
  amount        Int
  transaction   Transaction?

  @@index([receivableId])
}

model ReceivableInstallment {
  id            Int        @id @default(autoincrement())
  receivableId  Int
  receivable    Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  seq           Int
  month         String
  amount        Int
  paid          Boolean    @default(false)
  paidAt        DateTime?
  transaction   Transaction?

  @@unique([receivableId, seq])
}

// ---------------------------------------------------------------------------
// Investasi & aset
// ---------------------------------------------------------------------------
model Platform {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  sortOrder    Int          @default(0)
  investments  Investment[]
}

model AssetType {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  color        String   @default("#64748b")
  sortOrder    Int      @default(0)

  investments  Investment[]
  snapshots    AssetSnapshot[]
  targets      PortfolioTarget[]
  goals        Goal[]
}

model Investment {
  id              Int        @id @default(autoincrement())
  platformId      Int?
  platform        Platform?  @relation(fields: [platformId], references: [id])
  assetTypeId     Int?
  assetType       AssetType? @relation(fields: [assetTypeId], references: [id])
  description     String?
  principal       Int        @default(0)
  /// null = nilai akhir belum diisi -> profit "–"
  currentValue    Int?
  valueUpdatedAt  DateTime?
  sortOrder       Int        @default(0)

  transactions    Transaction[]
}

/// Asset Tracker: bulan x jenis aset. Baris tidak ada = kosong (bukan 0).
model AssetSnapshot {
  id           Int       @id @default(autoincrement())
  month        String
  assetTypeId  Int
  assetType    AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  value        Int

  @@unique([month, assetTypeId])
}

/// Catatan per bulan Asset Tracker (mis. alasan aset turun > 30%)
model AssetMonthNote {
  month  String @id
  note   String
}

model PortfolioTarget {
  id           Int       @id @default(autoincrement())
  month        String
  assetTypeId  Int
  assetType    AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  amount       Int

  @@unique([month, assetTypeId])
}

model PhysicalAsset {
  id         Int     @id @default(autoincrement())
  name       String
  value      Int
  note       String?
  sortOrder  Int     @default(0)
}

// ---------------------------------------------------------------------------
// Target & FIRE
// ---------------------------------------------------------------------------
model Goal {
  id               Int        @id @default(autoincrement())
  name             String
  targetAmount     BigInt
  /// Tenggat "YYYY-MM"
  deadline         String?
  /// "MANUAL" | "ASSET_TYPE" | "TRANSACTIONS"
  collectedMode    String     @default("MANUAL")
  manualCollected  BigInt     @default(0)
  assetTypeId      Int?
  assetType        AssetType? @relation(fields: [assetTypeId], references: [id], onDelete: SetNull)
  /// Urutan "tangga ternak uang"
  priority         Int        @default(0)
  /// Kalkulator FIRE (opsional)
  targetAge        Int?
  note             String?

  transactions     Transaction[]
}

model Resolution {
  id         Int      @id @default(autoincrement())
  year       Int
  text       String
  done       Boolean  @default(false)
  sortOrder  Int      @default(0)
}
